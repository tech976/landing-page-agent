# Landing Agent — environment
#
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
#   cp .env.example .env.local

# ── Provider selection ──────────────────────────────────────────────────────

# Which LLM drives /api/generate and /api/edit: "anthropic" (default) or "groq".
LLM_PROVIDER=anthropic

# ── Anthropic (production path — grammar-constrained tool use + prompt caching) ──

# Required when LLM_PROVIDER=anthropic. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-8. This is the model used for full page GENERATION,
# and the fallback for edits when routing is off.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Edit-model routing (cost optimisation) ──────────────────────────────────
#
# Each AI edit is classified (free, no LLM call) and routed to the cheapest model that
# can do it well, so a "change the price" edit doesn't pay Opus rates:
#   simple   → Haiku   (rename, price, typo, swap a CTA label)   ~5x cheaper than Opus
#   moderate → Sonnet  (rewrite a block's copy, add one element, change the offer)
#   complex  → Opus    (restructure, whole-page tone, "make it convert", multi-part asks)
# If a cheaper model's edit fails validation it auto-escalates to the next tier up, so a
# mis-route only ever costs a little — never correctness. Anthropic path only.

# Set to "off" to send every edit to ANTHROPIC_MODEL (disables routing). Default: on.
EDIT_MODEL_ROUTING=on

# Optional per-tier overrides. Defaults shown.
EDIT_MODEL_SIMPLE=claude-haiku-4-5
EDIT_MODEL_MODERATE=claude-sonnet-5
EDIT_MODEL_COMPLEX=claude-opus-4-8

# ── Groq (test path — OpenAI-compatible function calling, NOT grammar-constrained) ──

# Required when LLM_PROVIDER=groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b. Other options: openai/gpt-oss-20b,
# llama-3.3-70b-versatile, qwen/qwen3.6-27b, groq/compound, llama-3.1-8b-instant.
GROQ_MODEL=openai/gpt-oss-120b

# Optional escape hatch. Groq's per-model completion cap varies; lower this if the API
# rejects the default 32000-token request. Ignored on the Anthropic path.
GROQ_MAX_TOKENS=32000

# ── No key at all ───────────────────────────────────────────────────────────
#
# The whole UI can be developed and demoed without a key:
#   POST /api/generate  with  { "mock": true }
# persists the fully-populated example page from src/lib/generate/mock.ts.
